<!ELEMENT curriculums (cvEuropass)*>

<!ELEMENT cvEuropass (datos_personales, descripcion, experiencia_laboral, tecnologias, formacion, idiomas)>
<!ATTLIST cvEuropass id ID #REQUIRED>

	<!ELEMENT datos_personales (nombre, apellidos, sexo, nacionalidad, codigoPais, domicilio, contacto)>
		<!ELEMENT nombre (#PCDATA)>
		<!ELEMENT apellidos (#PCDATA)>
		<!ELEMENT sexo (#PCDATA)>
		<!ELEMENT nacionalidad (#PCDATA)>
		<!ELEMENT codigoPais (#PCDATA)>

		<!ELEMENT domicilio (numero?, calle?, codigoPostal?, ciudad)>
			<!ELEMENT numero (#PCDATA)>
			<!ELEMENT calle (#PCDATA)>
			<!ELEMENT codigoPostal (#PCDATA)>
			<!ELEMENT ciudad (#PCDATA)>

		<!ELEMENT contacto (correo, telefono)>
			<!ELEMENT correo (#PCDATA)>
			<!ELEMENT telefono (#PCDATA)>

	<!ELEMENT descripcion (#PCDATA)>
         
	<!ELEMENT experiencia_laboral (experiencia)*>
		<!ELEMENT experiencia (puesto, empresa)>
		<!ATTLIST experiencia inicio CDATA #REQUIRED>
		<!ATTLIST experiencia fin CDATA #IMPLIED>
		<!ATTLIST experiencia actual (true | false) #IMPLIED>
			<!ELEMENT puesto (#PCDATA)>
			<!ELEMENT empresa (#PCDATA)>

         
	<!ELEMENT tecnologias (tecnologia)*>
		<!ELEMENT tecnologia (#PCDATA)>
		<!ATTLIST tecnologia nivel (basico | intermedio | avanzado) #REQUIRED>
		 
	<!ELEMENT formacion (curso)*>
		<!ELEMENT curso (titulacion, centro, (modalidad | tipoCentro)?)>
		<!ATTLIST curso inicio CDATA #REQUIRED>
		<!ATTLIST curso fin CDATA #IMPLIED>
		<!ATTLIST curso actual (true | false) #IMPLIED>
			<!ELEMENT titulacion (#PCDATA)>
			<!ELEMENT centro (#PCDATA)>
			<!ELEMENT modalidad (#PCDATA)>
			<!ELEMENT tipoCentro (#PCDATA)>
			
	<!ELEMENT idiomas (codigoIdioma+)>
		<!ELEMENT codigoIdioma (#PCDATA)>
		<!ATTLIST codigoIdioma nivel CDATA #REQUIRED>



<!ENTITY centro_ies "IES Virgen de la Paz">